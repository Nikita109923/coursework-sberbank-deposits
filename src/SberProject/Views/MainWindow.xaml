<Window x:Class="SberProject.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SberProject.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Сбербанк — учет вкладчиков"
        Width="1240" Height="700" MinWidth="960" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <DockPanel>
        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="16,10">
            <StackPanel>
                <TextBlock Text="Сбербанк" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource OnPrimaryBrush}" />
                <TextBlock Text="Сведения о вкладчиках банка" Foreground="{StaticResource OnPrimaryMutedBrush}" />
            </StackPanel>
        </Border>

        <!-- Команды -->
        <WrapPanel DockPanel.Dock="Top" Margin="12,12,12,0">
            <Button Content="Открыть вклад" Command="{Binding OpenAccountCommand}" Style="{StaticResource PrimaryButton}" />
            <Button Content="Прием" Command="{Binding DepositCommand}" ToolTip="Принять деньги на выбранный вклад" />
            <Button Content="Выдача" Command="{Binding WithdrawCommand}" ToolTip="Выдать деньги с выбранного вклада" />
            <Button Content="История" Command="{Binding ShowHistoryCommand}" ToolTip="История операций по счету (или двойной щелчок по строке)" />
            <Button Content="Данные вкладчика" Command="{Binding EditDepositorCommand}" ToolTip="Изменить паспортные данные" />
            <Button Content="Закрыть вклад" Command="{Binding CloseAccountCommand}" Style="{StaticResource DangerButton}" />
            <Border Width="1" Height="26" Margin="6,0,12,6" Background="{StaticResource LineBrush}" />
            <Button Content="Начислить проценты" Command="{Binding AccrueInterestCommand}" />
            <Button Content="Категории вкладов" Command="{Binding ManageCategoriesCommand}" />
            <Button Content="Журнал" Command="{Binding ShowLogCommand}" />
            <Button Content="Экспорт в CSV" Command="{Binding ExportCommand}" ToolTip="Сохранить показанный список в файл для Excel" />
        </WrapPanel>

        <!-- Поиск, фильтр, сортировка -->
        <Border DockPanel.Dock="Top" Margin="12,6,12,10" Padding="10,8,10,0"
                Background="{StaticResource SurfaceBrush}" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Поиск:" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Номер счета, ФИО или номер паспорта" />

                <TextBlock Grid.Column="2" Text="Категория:" Style="{StaticResource FieldLabel}" Margin="16,0,8,8" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedCategoryOption}" />

                <TextBlock Grid.Column="4" Text="Сортировка:" Style="{StaticResource FieldLabel}" Margin="16,0,8,8" />
                <ComboBox Grid.Column="5" ItemsSource="{Binding SortFields}" SelectedItem="{Binding SelectedSortField}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox Grid.Column="6" Content="по убыванию" IsChecked="{Binding SortDescending}"
                          VerticalAlignment="Center" Margin="12,0,0,8" />
                <CheckBox Grid.Column="7" Content="показывать закрытые" IsChecked="{Binding IncludeClosed}"
                          VerticalAlignment="Center" Margin="16,0,0,8" />
            </Grid>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource SurfaceBrush}" Padding="12,5">
            <TextBlock Text="{Binding Summary}" />
        </Border>

        <!-- Список вкладов -->
        <Grid Margin="12,0,12,10">
            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
                <DataGrid.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ShowHistoryCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpen}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Номер лицевого счета" Binding="{Binding Number}" Width="180" FontFamily="Consolas" />
                    <DataGridTextColumn Header="ФИО вкладчика" Binding="{Binding FullName}" Width="*" MinWidth="200" />
                    <DataGridTextColumn Header="Паспорт" Binding="{Binding PassportNumber}" Width="100" />
                    <DataGridTextColumn Header="Категория вклада" Binding="{Binding DepositType, Converter={StaticResource EnumDescription}}" Width="150" />
                    <DataGridTextColumn Header="Сумма вклада" Binding="{Binding Balance, StringFormat=N2}" Width="120"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Начисл. проценты" Binding="{Binding AccruedInterest, StringFormat=N2}" Width="135"
                                        ElementStyle="{StaticResource NumberCell}" />
                    <DataGridTextColumn Header="Последняя операция" Binding="{Binding LastOperationAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="160" />
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource EnumDescription}}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Вклады не найдены" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accounts.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
